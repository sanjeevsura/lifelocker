<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="120dp"
    android:height="120dp"
    android:viewportWidth="120"
    android:viewportHeight="120">

    <!-- Shield Background Path -->
    <path
        android:pathData="M60,10 L100,28 V60 C100,85 60,110 60,110 C60,110 20,85 20,60 V28 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:endX="100"
                android:endY="110"
                android:startX="20"
                android:startY="10"
                android:type="linear">
                <item android:color="#0F172A" android:offset="0.0" />
                <item android:color="#1E293B" android:offset="0.5" />
                <item android:color="#0EA5E9" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Outer Shield Border Rim -->
    <path
        android:pathData="M60,14 L95,30 V58 C95,80 60,102 60,102 C60,102 25,80 25,58 V30 Z"
        android:strokeWidth="2.5"
        android:strokeColor="#38BDF8"
        android:fillColor="#00000000" />

    <!-- Lock Shackle -->
    <path
        android:pathData="M48,45 V38 C48,31.37 53.37,26 60,26 C66.63,26 72,31.37 72,38 V45"
        android:strokeWidth="5"
        android:strokeColor="#38BDF8"
        android:strokeLineCap="round"
        android:fillColor="#00000000" />

    <!-- Lock Body / Vault Box -->
    <path
        android:pathData="M42,45 H78 C81.31,45 84,47.69 84,51 V75 C84,78.31 81.31,81 78,81 H42 C38.69,81 36,78.31 36,75 V51 C36,47.69 38.69,45 42,45 Z"
        android:fillColor="#0EA5E9" />

    <!-- Keyhole & Vault L Accent -->
    <path
        android:pathData="M60,56 C62.2,56 64,57.8 64,60 C64,61.4 63.3,62.6 62.2,63.3 L63.5,71 C63.7,71.8 63,72.5 62,72.5 H58 C57,72.5 56.3,71.8 56.5,71 L57.8,63.3 C56.7,62.6 56,61.4 56,60 C56,57.8 57.8,56 60,56 Z"
        android:fillColor="#0F172A" />

    <!-- Clean Sharp Accent 'L' Brand Overlay -->
    <path
        android:pathData="M46,52 V74 H68"
        android:strokeWidth="3.5"
        android:strokeColor="#FFFFFF"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:fillColor="#00000000" />

</vector>
