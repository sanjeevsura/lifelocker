<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/android:colorBackground">

    <!-- Glowing Background Aura -->
    <ImageView
        android:id="@+id/iv_splash_glow"
        android:layout_width="280dp"
        android:layout_height="280dp"
        android:layout_gravity="center"
        android:src="@drawable/bg_pill_accent"
        android:alpha="0.25"
        android:scaleType="fitCenter"
        android:contentDescription="Glow Effect" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="32dp">

        <!-- Animated 3D Shield Logo -->
        <ImageView
            android:id="@+id/iv_splash_logo"
            android:layout_width="140dp"
            android:layout_height="140dp"
            android:src="@drawable/ic_shield_3d"
            android:contentDescription="LifeLocker Logo" />

        <TextView
            android:id="@+id/tv_splash_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:fontFamily="sans-serif-black"
            android:text="LifeLocker"
            android:textColor="?attr/colorOnSurface"
            android:textSize="32sp"
            android:letterSpacing="0.04" />

        <TextView
            android:id="@+id/tv_splash_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Secure. Organize. Simplify."
            android:textColor="@color/primary"
            android:textSize="14sp"
            android:letterSpacing="0.1" />

        <ProgressBar
            android:id="@+id/pb_splash_loading"
            style="@style/Widget.AppCompat.ProgressBar.Horizontal"
            android:layout_width="180dp"
            android:layout_height="6dp"
            android:layout_marginTop="40dp"
            android:indeterminate="false"
            android:max="100"
            android:progress="0"
            android:progressDrawable="@drawable/bg_pill_accent" />

        <TextView
            android:id="@+id/tv_splash_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Initializing Offline Security Engine..."
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="12sp" />
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="24dp"
        android:text="100% Offline · Bank-Grade AES-256-GCM"
        android:textColor="?attr/android:textColorHint"
        android:textSize="11sp"
        android:letterSpacing="0.08" />

</FrameLayout>
