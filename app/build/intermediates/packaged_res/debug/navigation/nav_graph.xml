<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_graph"
    app:startDestination="@id/nav_splash">

    <fragment
        android:id="@+id/nav_splash"
        android:name="com.lifelocker.ui.SplashFragment"
        android:label="Splash Screen" />

    <fragment
        android:id="@+id/nav_lock"
        android:name="com.lifelocker.ui.LockFragment"
        android:label="Lock Screen">
        <action
            android:id="@+id/action_lock_to_dashboard"
            app:destination="@id/nav_dashboard"
            app:popUpTo="@id/nav_lock"
            app:popUpToInclusive="true" />
        <action
            android:id="@+id/action_lock_to_emergency"
            app:destination="@id/nav_emergency" />
    </fragment>

    <fragment
        android:id="@+id/nav_dashboard"
        android:name="com.lifelocker.ui.DashboardFragment"
        android:label="Dashboard">
        <action
            android:id="@+id/action_dashboard_to_vault"
            app:destination="@id/nav_vault" />
        <action
            android:id="@+id/action_dashboard_to_documents"
            app:destination="@id/nav_documents" />
        <action
            android:id="@+id/action_dashboard_to_reminders"
            app:destination="@id/nav_reminders" />
        <action
            android:id="@+id/action_dashboard_to_emergency"
            app:destination="@id/nav_emergency" />
        <action
            android:id="@+id/action_dashboard_to_settings"
            app:destination="@id/nav_settings" />
    </fragment>

    <fragment
        android:id="@+id/nav_vault"
        android:name="com.lifelocker.ui.VaultListFragment"
        android:label="Vault">
        <action
            android:id="@+id/action_vault_to_addEdit"
            app:destination="@id/nav_add_edit_vault" />
    </fragment>

    <fragment
        android:id="@+id/nav_add_edit_vault"
        android:name="com.lifelocker.ui.AddEditVaultFragment"
        android:label="Add / Edit Vault Item">
        <argument
            android:name="vaultItemId"
            android:defaultValue="0"
            app:argType="integer" />
    </fragment>

    <fragment
        android:id="@+id/nav_documents"
        android:name="com.lifelocker.ui.DocumentListFragment"
        android:label="Documents">
        <action
            android:id="@+id/action_documents_to_addEdit"
            app:destination="@id/nav_add_edit_document" />
        <action
            android:id="@+id/action_documents_to_detail"
            app:destination="@id/nav_document_detail" />
        <action
            android:id="@+id/action_documents_to_add_reminder"
            app:destination="@id/nav_add_edit_reminder" />
    </fragment>

    <fragment
        android:id="@+id/nav_add_edit_document"
        android:name="com.lifelocker.ui.AddEditDocumentFragment"
        android:label="Add Document">
        <argument
            android:name="documentId"
            android:defaultValue="0"
            app:argType="integer" />
        <action
            android:id="@+id/action_add_edit_document_to_camera"
            app:destination="@id/nav_camera_scan" />
    </fragment>

    <fragment
        android:id="@+id/nav_document_detail"
        android:name="com.lifelocker.ui.DocumentDetailFragment"
        android:label="Document Detail">
        <argument
            android:name="documentId"
            android:defaultValue="0"
            app:argType="integer" />
        <action
            android:id="@+id/action_detail_to_add_reminder"
            app:destination="@id/nav_add_edit_reminder" />
        <action
            android:id="@+id/action_detail_to_edit_document"
            app:destination="@id/nav_add_edit_document" />
    </fragment>

    <fragment
        android:id="@+id/nav_reminders"
        android:name="com.lifelocker.ui.ReminderListFragment"
        android:label="Reminders">
        <action
            android:id="@+id/action_reminders_to_addEdit"
            app:destination="@id/nav_add_edit_reminder" />
    </fragment>

    <fragment
        android:id="@+id/nav_add_edit_reminder"
        android:name="com.lifelocker.ui.AddEditReminderFragment"
        android:label="Add Reminder">
        <argument
            android:name="reminderId"
            android:defaultValue="0"
            app:argType="integer" />
        <argument
            android:name="title"
            android:defaultValue=""
            app:argType="string" />
        <argument
            android:name="category"
            android:defaultValue=""
            app:argType="string" />
        <argument
            android:name="dueDate"
            android:defaultValue=""
            app:argType="string" />
    </fragment>

    <fragment
        android:id="@+id/nav_emergency"
        android:name="com.lifelocker.ui.EmergencyFragment"
        android:label="Emergency Info">
        <action
            android:id="@+id/action_emergency_to_addEdit"
            app:destination="@id/nav_add_edit_contact" />
    </fragment>

    <fragment
        android:id="@+id/nav_add_edit_contact"
        android:name="com.lifelocker.ui.AddEditContactFragment"
        android:label="Add Emergency Contact">
        <argument
            android:name="contactId"
            android:defaultValue="0"
            app:argType="integer" />
    </fragment>

    <fragment
        android:id="@+id/nav_settings"
        android:name="com.lifelocker.ui.SettingsFragment"
        android:label="Settings">
        <action
            android:id="@+id/action_settings_to_notes"
            app:destination="@id/nav_secure_notes" />
    </fragment>

    <fragment
        android:id="@+id/nav_camera_scan"
        android:name="com.lifelocker.ui.CameraScanFragment"
        android:label="Scan Document" />

    <fragment
        android:id="@+id/nav_secure_notes"
        android:name="com.lifelocker.ui.SecureNotesFragment"
        android:label="Secure Notes">
        <action
            android:id="@+id/action_notes_to_addEdit"
            app:destination="@id/nav_add_edit_note" />
    </fragment>

    <fragment
        android:id="@+id/nav_add_edit_note"
        android:name="com.lifelocker.ui.AddEditNoteFragment"
        android:label="Add Secure Note">
        <argument
            android:name="noteId"
            android:defaultValue="0"
            app:argType="integer" />
    </fragment>

</navigation>
